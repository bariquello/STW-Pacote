<?xml version="1.0" encoding="utf-8" ?>
<packagegui>
	<description>STW - Backup FTP e Tema</description>
	<requirements>pfSense CE 2.8 / Plus 24.x</requirements>
	<faq>Uso interno System Way - Base de Conhecimento 338.</faq>
	<name>stwpacote</name>
	<version>0.6</version>
	<title>Services/STW Backup FTP</title>
	<include_file>/usr/local/pkg/stw_pacote.inc</include_file>
	<menu>
		<name>STW Backup FTP</name>
		<tooltiptext>Configurar a rotina de Backup via FTP (System Way)</tooltiptext>
		<section>Services</section>
		<url>/pkg_edit.php?xml=stw_pacote.xml</url>
	</menu>
	<service>
		<name>stw_backup</name>
		<rcfile>stw_backup.sh</rcfile>
		<executable>stw_backup</executable>
		<description>STW Backup FTP (System Way)</description>
	</service>
	<configpath>installedpackages/stwpacote/config</configpath>
	<fields>
		<field><name>Rotina de Backup via FTP</name><type>listtopic</type></field>
		<field>
			<fielddescr>Agendar backup diario (cron)</fielddescr>
			<fieldname>enable</fieldname>
			<description>O /etc/backup.sh e SEMPRE gerado ao salvar. Marque para tambem AGENDAR no cron.</description>
			<type>checkbox</type>
		</field>
		<field><fielddescr>Servidor FTP (HOST)</fielddescr><fieldname>host</fieldname><type>input</type><default_value>monitoramento.systemway.com.br</default_value><size>40</size><required/></field>
		<field><fielddescr>Porta FTP</fielddescr><fieldname>porta</fieldname><type>input</type><default_value>21000</default_value><size>8</size><required/></field>
		<field><fielddescr>Usuario FTP</fielddescr><fieldname>usuario</fieldname><description>Altere conforme a empresa/usuario do FTP.</description><type>input</type><default_value>pfsense</default_value><size>30</size><required/></field>
		<field><fielddescr>Senha FTP</fielddescr><fieldname>senha</fieldname><type>password</type><size>30</size><required/></field>
		<field><fielddescr>Prefixo do arquivo (ARQUIVO)</fielddescr><fieldname>arquivo</fieldname><description>Atente-se ao nome do firewall! Ex.: firewall.*</description><type>input</type><default_value>firewall.*</default_value><size>30</size><required/></field>
		<field><fielddescr>Horario do backup diario</fielddescr><fieldname>hora_cron</fieldname><description>Hora (0-23) para o cron. Minuto fixo em 0.</description><type>input</type><default_value>3</default_value><size>4</size></field>

		<field><name>Dependencias e Monitoramento</name><type>listtopic</type></field>
		<field>
			<fielddescr>Verificar/instalar dependencias</fielddescr>
			<fieldname>instalar_deps</fieldname>
			<description>Ao salvar, verifica e instala (somente se ausentes): Cron, Zabbix Agent 5.0 e Zabbix Proxy 5.0, alem de provisionar /root/scripts/pfsense_zbx.php. Pacotes ja instalados sao ignorados.</description>
			<type>checkbox</type>
		</field>

		<field><name>Tema pfSense-Systemway</name><type>listtopic</type></field>
		<field><fielddescr>Reaplicar tema pfSense-Systemway</fielddescr><fieldname>aplicar_tema</fieldname><description>Ao salvar, refaz o deploy do tema em /usr/local/www.</description><type>checkbox</type></field>
	</fields>
	<custom_php_install_command>stw_pacote_install();</custom_php_install_command>
	<custom_php_deinstall_command>stw_pacote_deinstall();</custom_php_deinstall_command>
	<custom_php_resync_config_command>stw_pacote_resync();</custom_php_resync_config_command>
</packagegui>
